/* ============================================
   词汇卡片组件 - 贴纸感设计
   明亮 · 现代 · 温暖 · 亲子友好
   ============================================ */

.sticker-card {
  background: #ffffff;
  border-radius: 36rpx;
  padding: 0;
  position: relative;
  overflow: visible;
  box-shadow:
    0 8rpx 32rpx rgba(91, 156, 246, 0.13),
    0 2rpx 8rpx rgba(91, 156, 246, 0.08);
  animation: cardPopIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 轻微弹入动画 */
@keyframes cardPopIn {
  0% {
    opacity: 0;
    transform: scale(0.82) translateY(24rpx);
  }
  100% {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* 卡片左上角装饰圆点 */
.sticker-card::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: 32rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(91, 156, 246, 0.2);
  border-radius: 50%;
  z-index: 0;
}

.sticker-card::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 60rpx;
  width: 16rpx;
  height: 16rpx;
  background: rgba(72, 187, 120, 0.2);
  border-radius: 50%;
  z-index: 0;
}

/* ---- Card Header (Image Area) ---- */
.card-header {
  padding: 28rpx 28rpx 0;
}

.image-sticker-wrap {
  position: relative;
  display: inline-block;
}

.image-sticker {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  border: 6rpx solid #ffffff;
  box-shadow:
    0 6rpx 20rpx rgba(91, 156, 246, 0.18),
    0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  margin: 0 auto;
}

.image-sticker.placeholder {
  background: linear-gradient(135deg, #e8f0ff 0%, #dce4ff 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 64rpx;
  opacity: 0.5;
}

.sticker-img {
  width: 100%;
  height: 100%;
}

/* 贴纸胶带装饰 */
.sticker-tape {
  position: absolute;
  width: 60rpx;
  height: 20rpx;
  background: rgba(255, 234, 167, 0.85);
  border-radius: 2rpx;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%) rotate(-2deg);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.05);
}

.tape-top {
  /* 顶部胶带 */
}

/* ---- Card Badge ---- */
.card-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  background: linear-gradient(135deg, #5b9cf6 0%, #4f8edc 100%);
  padding: 6rpx 14rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
  box-shadow: 0 2rpx 8rpx rgba(91, 156, 246, 0.3);
  z-index: 2;
}

.badge-icon {
  font-size: 18rpx;
}

.badge-text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 600;
  white-space: nowrap;
}

/* ---- Language Tabs ---- */
.lang-tabs {
  display: flex;
  gap: 8rpx;
  padding: 24rpx 28rpx 0;
}

.lang-tab {
  padding: 8rpx 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #a0aec0;
  background: #f0f5ff;
  transition: all 0.2s ease;
}

.lang-tab.active {
  background: linear-gradient(135deg, #5b9cf6 0%, #4f8edc 100%);
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(91, 156, 246, 0.3);
}

/* ---- Word Display ---- */
.word-display {
  padding: 16rpx 28rpx 0;
}

.word-main {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a202c;
  display: block;
  line-height: 1.2;
  margin-bottom: 4rpx;
}

.word-phonetic {
  font-size: 24rpx;
  color: #a0aec0;
  font-style: italic;
  display: block;
  margin-bottom: 8rpx;
}

/* ---- Multilingual Rows ---- */
.lang-rows {
  margin: 16rpx 28rpx 0;
  background: #f7f8fc;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
}

.lang-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.lang-row:last-child {
  border-bottom: none;
}

.lang-flag {
  font-size: 26rpx;
  margin-right: 14rpx;
  width: 36rpx;
  text-align: center;
}

.lang-value {
  font-size: 26rpx;
  color: #2d3748;
  font-weight: 500;
}

/* ---- Example Section ---- */
.example-section {
  padding: 0 28rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.example-block {
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
}

.example-en {
  background: #eef4ff;
  border-left: 4rpx solid #5b9cf6;
}

.example-zh {
  background: #f0fff4;
  border-left: 4rpx solid #48bb78;
}

.example-label {
  font-size: 20rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 4rpx;
}

.example-en .example-label {
  color: #5b9cf6;
}

.example-zh .example-label {
  color: #48bb78;
}

.example-text {
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.6;
}

/* ---- Kid Note ---- */
.kid-note {
  margin: 16rpx 28rpx 0;
  background: #fffbf0;
  border: 1rpx solid #fef3c7;
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.kid-note-icon {
  font-size: 24rpx;
  flex-shrink: 0;
  margin-top: 1rpx;
}

.kid-note-text {
  font-size: 22rpx;
  color: #744210;
  line-height: 1.6;
}

/* ---- Tags ---- */
.tags-row {
  padding: 0 28rpx;
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  background: #edf2f7;
  color: #718096;
  padding: 5rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
}

/* ---- Confidence Mini (compact mode) ---- */
.confidence-mini {
  padding: 0 28rpx 8rpx;
  margin-top: 8rpx;
}

.confidence-text {
  font-size: 20rpx;
  color: #a0aec0;
}

/* ---- Compact Mode ---- */
.sticker-card.compact {
  border-radius: 28rpx;
  padding: 0;
}

.sticker-card.compact::before,
.sticker-card.compact::after {
  display: none;
}

.sticker-card.compact .word-main {
  font-size: 38rpx;
  padding: 0 20rpx;
}

.sticker-card.compact .word-display {
  padding-top: 12rpx;
}

.sticker-card.compact .card-badge {
  top: 14rpx;
  right: 14rpx;
  padding: 5rpx 12rpx;
}

.sticker-card.compact .badge-text {
  font-size: 16rpx;
}