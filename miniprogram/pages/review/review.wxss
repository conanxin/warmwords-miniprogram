/* ============================================
   复习页 - 轻量游戏感
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(170deg, #eef3ff 0%, #f5f7ff 100%);
  padding: 40rpx 32rpx 200rpx;
  box-sizing: border-box;
}

/* ---- Page Header ---- */
.page-header {
  margin-bottom: 36rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #718096;
  display: block;
  line-height: 1.5;
}

/* ---- Empty State ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #48bb78;
  margin-bottom: 14rpx;
  max-width: 450rpx;
  line-height: 1.6;
}

.empty-sub {
  font-size: 26rpx;
  color: #a0aec0;
  margin-bottom: 48rpx;
}

.empty-cta {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  color: #ffffff;
  padding: 26rpx 52rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 8rpx 24rpx rgba(72, 187, 120, 0.35);
}

/* ---- Review List ---- */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.review-item {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow:
    0 6rpx 24rpx rgba(91, 156, 246, 0.1),
    0 2rpx 6rpx rgba(91, 156, 246, 0.06);
  border: 1rpx solid rgba(91, 156, 246, 0.08);
  animation: cardIn 0.3s ease-out;
}

@keyframes cardIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---- Word Area ---- */
.review-word-area {
  text-align: center;
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid #f0f5ff;
  margin-bottom: 16rpx;
}

.review-word-en {
  font-size: 48rpx;
  font-weight: 800;
  color: #1a202c;
  display: block;
  margin-bottom: 4rpx;
}

.review-word-phonetic {
  font-size: 24rpx;
  color: #a0aec0;
  font-style: italic;
  display: block;
  margin-bottom: 6rpx;
}

.review-word-zh {
  font-size: 26rpx;
  color: #718096;
}

/* ---- Example ---- */
.review-example {
  background: #f7f8fc;
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 20rpx;
}

.review-example-text {
  font-size: 24rpx;
  color: #4a5568;
  line-height: 1.6;
}

/* ---- Action Buttons ---- */
.review-actions {
  display: flex;
  gap: 16rpx;
}

.review-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
  transition: transform 0.15s, box-shadow 0.15s;
}

.btn-learning {
  background: #fff5f5;
  color: #e53e3e;
  border: 2rpx solid #fed7d7;
}

.btn-known {
  background: #f0fff4;
  color: #48bb78;
  border: 2rpx solid #c6f6d5;
}

.btn-active {
  transform: scale(0.96);
  opacity: 0.85;
}