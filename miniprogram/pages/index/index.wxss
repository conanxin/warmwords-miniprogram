/* ============================================
   首页 - 明亮温暖亲子风格
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(175deg, #dce9ff 0%, #eef3ff 40%, #f5f7ff 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 180rpx;
  position: relative;
  overflow: hidden;
}

/* ---- Hero 背景装饰 ---- */
.hero {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 40rpx 40rpx;
  position: relative;
}

.hero-bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.5;
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(91, 156, 246, 0.18) 0%, transparent 70%);
  top: -80rpx;
  right: -60rpx;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(72, 187, 120, 0.14) 0%, transparent 70%);
  top: 40rpx;
  left: -80rpx;
}

/* ---- Logo 区 ---- */
.hero-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.product-logo {
  font-size: 88rpx;
  margin-bottom: 20rpx;
  filter: drop-shadow(0 4rpx 12rpx rgba(91, 156, 246, 0.3));
}

.product-name {
  font-size: 56rpx;
  font-weight: 800;
  color: #1a202c;
  letter-spacing: 6rpx;
  margin-bottom: 16rpx;
}

.slogan {
  font-size: 28rpx;
  color: #4a5568;
  margin-bottom: 12rpx;
  max-width: 520rpx;
  line-height: 1.6;
}

.sub-slogan {
  font-size: 24rpx;
  color: #a0aec0;
  max-width: 480rpx;
  line-height: 1.8;
  white-space: pre-line;
}

/* ---- Feature Chips ---- */
.feature-chips {
  display: flex;
  gap: 16rpx;
  margin-bottom: 0;
  flex-wrap: wrap;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.chip {
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(91, 156, 246, 0.15);
  border-radius: 50rpx;
  padding: 10rpx 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 2rpx 8rpx rgba(91, 156, 246, 0.08);
}

.chip-icon {
  font-size: 24rpx;
}

.chip-text {
  font-size: 22rpx;
  color: #4a5568;
  font-weight: 500;
}

/* ---- Action Area ---- */
.action-area {
  width: 100%;
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

/* 主按钮：拍下一个单词 */
.btn-camera {
  width: 100%;
  background: linear-gradient(135deg, #5b9cf6 0%, #4f8edc 100%);
  border: none;
  border-radius: 36rpx;
  padding: 32rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(91, 156, 246, 0.38);
  position: relative;
  overflow: hidden;
}

.btn-camera::after {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
  pointer-events: none;
}

.btn-camera-icon {
  font-size: 56rpx;
  flex-shrink: 0;
}

.btn-camera-text {
  display: flex;
  flex-direction: column;
  text-align: left;
}

.btn-camera-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.btn-camera-sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 4rpx;
}

/* 次按钮：从相册选择 */
.btn-album {
  width: 100%;
  background: #ffffff;
  border: 2rpx solid rgba(91, 156, 246, 0.25);
  border-radius: 36rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(91, 156, 246, 0.1);
}

.btn-album-icon {
  font-size: 36rpx;
}

.btn-album-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #5b9cf6;
  letter-spacing: 1rpx;
}

.btn-active {
  transform: scale(0.97);
  opacity: 0.88;
}

/* ---- Inspiration Area ---- */
.inspiration-area {
  width: 100%;
  padding: 0 40rpx;
}

.inspiration-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #718096;
  margin-bottom: 20rpx;
  display: block;
}

.inspiration-list {
  display: flex;
  gap: 20rpx;
}

.inspiration-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(91, 156, 246, 0.12);
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 16rpx rgba(91, 156, 246, 0.08);
}

.inspiration-emoji {
  font-size: 44rpx;
}

.inspiration-desc {
  font-size: 22rpx;
  color: #718096;
  text-align: center;
  line-height: 1.5;
}

/* ---- Bottom Nav ---- */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(91, 156, 246, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 80rpx;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-decoration: none;
}

.nav-icon {
  font-size: 44rpx;
}

.nav-label {
  font-size: 22rpx;
  color: #718096;
  font-weight: 500;
}