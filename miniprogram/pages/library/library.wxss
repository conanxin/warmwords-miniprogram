/* ============================================
   贴纸书页 - 我的收藏
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(170deg, #eef3ff 0%, #f5f7ff 100%);
  padding: 40rpx 32rpx 200rpx;
  box-sizing: border-box;
}

/* ---- Page Header ---- */
.page-header {
  margin-bottom: 36rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: #718096;
  display: block;
  line-height: 1.5;
}

/* ---- Empty State ---- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4a5568;
  margin-bottom: 14rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #a0aec0;
  line-height: 1.7;
  max-width: 460rpx;
  margin-bottom: 48rpx;
}

.empty-cta {
  background: linear-gradient(135deg, #5b9cf6 0%, #4f8edc 100%);
  color: #ffffff;
  padding: 26rpx 52rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-decoration: none;
  box-shadow: 0 8rpx 24rpx rgba(91, 156, 246, 0.35);
}

/* ---- Sticker Grid ---- */
.sticker-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sticker-grid-item {
  animation: gridItemIn 0.3s ease-out;
}

@keyframes gridItemIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.grid-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow:
    0 4rpx 16rpx rgba(91, 156, 246, 0.1),
    0 1rpx 4rpx rgba(91, 156, 246, 0.06);
  border: 1rpx solid rgba(91, 156, 246, 0.08);
}

.grid-card-image {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #e8f0ff 0%, #dce4ff 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid rgba(91, 156, 246, 0.15);
}

.grid-card-emoji {
  font-size: 48rpx;
  opacity: 0.6;
}

.grid-card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
}

.grid-card-en {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a202c;
}

.grid-card-zh {
  font-size: 24rpx;
  color: #718096;
}

.grid-card-count {
  font-size: 20rpx;
  color: #a0aec0;
  margin-top: 4rpx;
}

/* ---- Page Footer ---- */
.page-footer {
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.btn-clear {
  background: #ffffff;
  color: #e53e3e;
  border: 1rpx solid #fed7d7;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
  font-size: 26rpx;
}

.btn-active {
  opacity: 0.75;
}