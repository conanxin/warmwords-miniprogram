/* ============================================
   结果页 - 词汇贴纸生成页
   ============================================ */

.page {
  min-height: 100vh;
  background: linear-gradient(170deg, #dce9ff 0%, #eef3ff 50%, #f5f7ff 100%);
  padding: 32rpx 32rpx 200rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* ---- Decorative Background ---- */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.deco-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(91, 156, 246, 0.15);
}

.dot-1 {
  width: 120rpx;
  height: 120rpx;
  top: 80rpx;
  right: 40rpx;
}

.dot-2 {
  width: 80rpx;
  height: 80rpx;
  top: 200rpx;
  left: 30rpx;
}

.dot-3 {
  width: 60rpx;
  height: 60rpx;
  top: 320rpx;
  right: 80rpx;
  background: rgba(72, 187, 120, 0.12);
}

.deco-glow {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(91, 156, 246, 0.08) 0%, transparent 70%);
  top: -100rpx;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
}

/* ---- Top Status ---- */
.top-status {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-bottom: 32rpx;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(72, 187, 120, 0.12);
  border: 1rpx solid rgba(72, 187, 120, 0.25);
  border-radius: 50rpx;
  padding: 10rpx 24rpx;
  margin-bottom: 12rpx;
}

.status-check {
  font-size: 24rpx;
  color: #48bb78;
  font-weight: 700;
}

.status-text {
  font-size: 24rpx;
  color: #48bb78;
  font-weight: 600;
}

.status-hint {
  font-size: 26rpx;
  color: #718096;
}

/* ---- Card Area ---- */
.card-area {
  position: relative;
  z-index: 1;
  margin-bottom: 36rpx;
}

/* ---- Action Bar ---- */
.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 1;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: transform 0.2s, box-shadow 0.2s;
}

.play-btn {
  background: #ffffff;
  color: #5b9cf6;
  border: 2rpx solid rgba(91, 156, 246, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(91, 156, 246, 0.12);
}

.save-btn {
  background: linear-gradient(135deg, #5b9cf6 0%, #4f8edc 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(91, 156, 246, 0.35);
}

.save-btn.saved {
  background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
  box-shadow: 0 6rpx 20rpx rgba(72, 187, 120, 0.35);
}

.action-icon {
  font-size: 36rpx;
}

.action-label {
  letter-spacing: 1rpx;
}

.btn-active {
  transform: scale(0.97);
  opacity: 0.88;
}

/* ---- Back Button ---- */
.btn-back {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(10px);
  color: #5b9cf6;
  border: 1rpx solid rgba(91, 156, 246, 0.15);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.btn-back text {
  letter-spacing: 1rpx;
}

/* ---- Compliance Notice ---- */
.compliance-notice {
  position: relative;
  z-index: 1;
  margin: 0 0 24rpx;
  padding: 20rpx 28rpx;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(8px);
  border-radius: 20rpx;
  border: 1rpx solid rgba(91, 156, 246, 0.12);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}


.notice-main {
  font-size: 24rpx;
  color: #718096;
  line-height: 1.5;
}

.notice-sub {
  font-size: 22rpx;
  color: #a0aec0;
  line-height: 1.5;
}