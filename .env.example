# ===============================================
# WarmWords Mini Program — Environment Variables
# ===============================================
# Copy this file to .env and fill in your real values.
# IMPORTANT: Never commit .env or any file with real secrets to GitHub.
# ===============================================

# --- AI Vision Provider ---
# Your vision API endpoint
AI_PROVIDER_BASE_URL=https://api.example.com/v1
# Your vision API key (from your AI provider dashboard)
AI_PROVIDER_API_KEY=replace_with_your_api_key
# Model name for vision recognition
AI_PROVIDER_MODEL=replace_with_your_vision_model

# --- Tencent Cloud TTS ---
# SecretId from Tencent Cloud CAM (https://console.tencentcloud.com/cam/cam-overview)
TTS_SECRET_ID=replace_with_your_tencent_secret_id
# SecretKey from Tencent Cloud CAM
TTS_SECRET_KEY=replace_with_your_tencent_secret_key
# Region for Tencent Cloud services (default: ap-guangzhou)
TTS_REGION=ap-guangzhou
# Voice type for TTS (101001 = en-US female, see Tencent docs)
TTS_VOICE_TYPE=101001
# Audio codec (mp3 or pcm)
TTS_CODEC=mp3
# Sample rate (16000 recommended for WeChat)
TTS_SAMPLE_RATE=16000

# --- WeChat Cloud Functions ---
# NOTE: WeChat cloud functions do NOT support QCLOUD_ / SCF_ / TENCENTCLOUD_ prefixes.
# Use the names above (TTS_SECRET_ID, etc.) — they map to cloud function env vars.

# --- Notes ---
# 1. These variables are used by WeChat cloud functions.
# 2. Set them in: WeChat Developer Tools → Cloud Development → Environment Variables
# 3. Or set them per cloud function in: cloudfunctions/<name>/config.json (local only, do NOT commit).
# 4. The cloud function code reads them via process.env.VARNAME.
# 5. For local development, a .env file is used (excluded from git).